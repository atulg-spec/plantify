# Plantify Environment Configuration Template
# Copy this file to .env and configure secrets accordingly.

# Django Security
DJANGO_SECRET_KEY=django-insecure-replace-this-in-production-with-a-random-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Cloudflare Workers AI Credentials (Optional — fallback uses DB CloudflareConfig)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
